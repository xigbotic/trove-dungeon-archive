[Dungeon]
Type = Dungeon
#Mode = 3-star dungeon
#Title = Energy Generator
#Creator = Evilagician
#EvilSpecial = the funky disco tower & discoland version is the ultra rare version of this dungeon.

#Socketlayout:
#SOCKET 0 =	Dungeon plug
#SOCKET 1 =	Land plugs
#SOCKET 2 =	building plugs
#SOCKET 3 =	land colors
#SOCKET 4 =	building colors
#SOCKET 5 =	main tower
#SOCKET 6 =	random boss fights minor
#SOCKET 7 =	random boss fights major
#SOCKET 8 =	roof

#Socket 0 -> Socket 1 & 2 for land and building colors. These enable 25 building options.
#Socket 0 -> Socket 8 for the invisible roof
#Socket 1 -> Socket 3 
#Socket 2 -> Socket 4 & Socket 5



